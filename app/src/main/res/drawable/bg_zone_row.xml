<?xml version="1.0" encoding="utf-8"?>
<!--
    Row inside the "edit timezones" card. While it is being dragged the row is activated and gets a
    dotted accent outline, so it is clear which one the finger has picked up.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_secondary" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accent"
                android:dashWidth="2dp"
                android:dashGap="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
