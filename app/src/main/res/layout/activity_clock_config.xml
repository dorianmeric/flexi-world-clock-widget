<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="@string/time_font" />

        <Spinner
            android:id="@+id/time_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/time_size" />

        <SeekBar
            android:id="@+id/time_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/time_size_value"
            style="@style/ValueLabel" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/date_font" />

        <Spinner
            android:id="@+id/date_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/date_size" />

        <SeekBar
            android:id="@+id/date_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/date_size_value"
            style="@style/ValueLabel" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/left_padding" />

        <SeekBar
            android:id="@+id/left_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/left_padding_value"
            style="@style/ValueLabel" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/preview" />

        <FrameLayout
            android:id="@+id/preview_host"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@color/surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>