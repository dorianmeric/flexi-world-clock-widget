<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Sticky action bar: title on the left, actions on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clock_config_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/cancel"
            style="@style/SecondaryButton"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/save"
            style="@style/PrimaryButton"
            android:text="@string/save" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/ScreenSubtitle"
                android:layout_marginTop="0dp"
                android:text="@string/clock_config_subtitle" />

            <!-- Live preview -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_preview" />

                <FrameLayout
                    android:id="@+id/preview_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_preview_stage"
                    android:minHeight="96dp"
                    android:padding="14dp" />
            </LinearLayout>

            <!-- Time -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_time" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/time_font" />

                <Spinner
                    android:id="@+id/time_font"
                    style="@style/ValueSpinner" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/time_size" />

                <SeekBar
                    android:id="@+id/time_size"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/time_size_value"
                    style="@style/ValueLabel" />
            </LinearLayout>

            <!-- Date -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_date" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/date_font" />

                <Spinner
                    android:id="@+id/date_font"
                    style="@style/ValueSpinner" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/date_size" />

                <SeekBar
                    android:id="@+id/date_size"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/date_size_value"
                    style="@style/ValueLabel" />
            </LinearLayout>

            <!-- Layout -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_layout" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/left_padding" />

                <SeekBar
                    android:id="@+id/left_padding"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/left_padding_value"
                    style="@style/ValueLabel" />
            </LinearLayout>

            <!-- Background -->
            <include layout="@layout/panel_background" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>