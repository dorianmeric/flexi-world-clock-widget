<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
                    android:id="@+id/zones_header"
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="@string/zones" />

        <LinearLayout
            android:id="@+id/zone_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/add_zone"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_timezone" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/city_font" />

        <Spinner
            android:id="@+id/city_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/city_size" />

        <SeekBar
            android:id="@+id/city_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/city_size_value"
            style="@style/ValueLabel" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/time_font_label" />

        <Spinner
            android:id="@+id/time_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/time_size_label" />

        <SeekBar
            android:id="@+id/time_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/time_size_value"
            style="@style/ValueLabel" />

        <CheckBox
            android:id="@+id/show_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/show_offset" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/offset_size" />

        <SeekBar
            android:id="@+id/offset_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/offset_size_value"
            style="@style/ValueLabel" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/spacing" />

        <SeekBar
            android:id="@+id/spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/spacing_value"
            style="@style/ValueLabel" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/widget_width" />

        <SeekBar
            android:id="@+id/width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/width_value"
            style="@style/ValueLabel" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/preview" />

        <FrameLayout
            android:id="@+id/preview_host"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@color/surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>