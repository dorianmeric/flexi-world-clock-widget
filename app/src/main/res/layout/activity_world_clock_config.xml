<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/world_config_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/cancel"
            style="@style/SecondaryButton"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/save"
            style="@style/PrimaryButton"
            android:text="@string/save" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/ScreenSubtitle"
                android:layout_marginTop="0dp"
                android:text="@string/world_config_subtitle" />

            <!-- Live preview -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_preview" />

                <FrameLayout
                    android:id="@+id/preview_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_preview_stage"
                    android:minHeight="96dp"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Timezones, with drag-and-drop reordering -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/zones_header"
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/zones" />

                    <Button
                        android:id="@+id/add_zone"
                        style="@style/SmallButton"
                        android:text="@string/add_timezone" />
                </LinearLayout>

                <TextView
                    style="@style/CardCaption"
                    android:text="@string/zones_hint" />

                <LinearLayout
                    android:id="@+id/zone_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- City typography -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/city_font" />

                <Spinner
                    android:id="@+id/city_font"
                    style="@style/ValueSpinner"
                    android:layout_marginTop="10dp" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/city_size" />

                <SeekBar
                    android:id="@+id/city_size"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/city_size_value"
                    style="@style/ValueLabel" />
            </LinearLayout>

            <!-- Time typography -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/time_font_label" />

                <Spinner
                    android:id="@+id/time_font"
                    style="@style/ValueSpinner"
                    android:layout_marginTop="10dp" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/time_size_label" />

                <SeekBar
                    android:id="@+id/time_size"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/time_size_value"
                    style="@style/ValueLabel" />
            </LinearLayout>

            <!-- UTC offset -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_offset" />

                <CheckBox
                    android:id="@+id/show_offset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/show_offset"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/offset_size" />

                <SeekBar
                    android:id="@+id/offset_size"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/offset_size_value"
                    style="@style/ValueLabel" />
            </LinearLayout>

            <!-- Size and spacing -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_size" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/widget_width" />

                <SeekBar
                    android:id="@+id/width"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/width_value"
                    style="@style/ValueLabel" />

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/spacing" />

                <SeekBar
                    android:id="@+id/spacing"
                    style="@style/ValueSlider" />

                <TextView
                    android:id="@+id/spacing_value"
                    style="@style/ValueLabel" />
            </LinearLayout>

            <!-- Background -->
            <include layout="@layout/panel_background" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>