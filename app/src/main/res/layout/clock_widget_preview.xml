<?xml version="1.0" encoding="utf-8"?>
<!--
    Static preview shown in the launcher's widget picker. The launcher inflates this
    itself, so it shows a fixed sample time instead of a live clock.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/preview_clock_time"
            android:textColor="@color/widget_time_text"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/preview_clock_date"
            android:textColor="@color/widget_date_text"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>